module branch_unit
(

	input logic [31:0] pc,
	input logic [31:0] rs1,
	input logic [31:0] rs2,
	input logic [31:0] immediate,
	input logic [2:0] branch_op,


	output logic [31:0] new_pc
	
);

typedef enum logic [2:0]
{
	
	BEQ,
	BNE,
	BLT,
	BGE,
	BLTU,
	BGEU,
	JAL,
	JALR

} op_t;

logic [31:0] branch_target;
logic [31:0] pc_inc4;

always_comb
begin

branch_target = pc + immediate;
pc_inc4 = pc + 4;

	case (op_t'(branch_op))

		BEQ: new_pc = (rs1 == rs2) ? branch_target : pc_inc4;
		BNE: new_pc = (rs1 != rs2) ? branch_target : pc_inc4;
		BLT: new_pc = ($signed(rs1) < $signed(rs2)) ? branch_target : pc_inc4;
		BGE: new_pc = ($signed(rs1) >= $signed(rs2)) ? branch_target : pc_inc4;
		BLTU: new_pc = (rs1 < rs2) ? branch_target : pc_inc4;
		BGEU: new_pc = (rs1 >= rs2) ? branch_target : pc_inc4;
		JAL: new_pc = branch_target;
		JALR: new_pc = (immediate + rs1) & 0xFFFFFFFE;
		default: new_pc = pc_inc4; //default pc_inc

	endcase

end


endmodule